# --- Python / Runtime Environment ---
PYTHON_VERSION=3.11.9

# --- Streamlit Server Settings ---
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# --- Optional External AI Provider (OpenAI / Groq / Custom LLM) ---
# If AI_PROVIDER_ENABLED is false, the app automatically uses the built-in offline NLP engine
AI_PROVIDER_ENABLED=false
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# --- Optional MySQL Database (If not using default built-in SQLite) ---
DB_URL=jdbc:mysql://localhost:3306/hostel_management?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

